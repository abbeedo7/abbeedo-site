{
  "name": "abunasser-tv-windows",
  "version": "1.2.1",
  "private": true,
  "description": "abbeedo TV for Windows",
  "author": "Abunasser",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.cjs",
    "build:portable": "node scripts/build.cjs --portable"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.abunasser.tv.windows",
    "productName": "abbeedo TV",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "security.cjs",
      "app-config.json",
      "error.html",
      "error.js",
      "assets/icon.png",
      "package.json",
      "presentation.cjs",
      "assets/abbeedo.otf",
      "update-monitor.cjs",
      "window-state.cjs",
      "updater.cjs",
      "client-provider.cjs",
      "provider-fetch.cjs",
      {
        "from": "../application/worker",
        "to": "client-worker",
        "filter": ["client-api.mjs", "watch-party.mjs", "media-sniff.mjs"]
      }
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "artifactName": "abbeedo-TV-${version}-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "$(AbbeedoAppName)",
      "artifactName": "abbeedo-TV-Setup.exe",
      "include": "assets/installer-languages.nsh",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "displayLanguageSelector": false,
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp",
      "installerHeader": "assets/installer-header.bmp"
    },
    "toolsets": {
      "wine": "1.0.1"
    },
    "publish": null,
    "portable": {
      "artifactName": "abbeedo-TV-Portable.exe",
      "requestExecutionLevel": "user",
      "unpackDirName": true
    }
  }
}
